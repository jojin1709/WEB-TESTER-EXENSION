{
  "manifest_version": 3,
  "name": "WebTester Pro",
  "version": "1.0.0",
  "description": "Ultimate bug bounty and web application security testing assistant \u2014 by Jojin John",
  "author": "Jojin John",
  "homepage_url": "https://github.com/jojin1709/WEB-TESTER-EXENSION",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    },
    "default_title": "WebTester Pro"
  },
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab",
    "tabs",
    "clipboardWrite",
    "clipboardRead",
    "notifications",
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "js/background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "pages/*",
        "css/*",
        "js/*",
        "data/*",
        "icons/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
